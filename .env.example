# Docker Compose runtime variables. Copy to .env and replace the values.
APP_PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Production MySQL (used with docker-compose.production.yml)
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
# Optional: override the generated Docker Compose database URL.
# DATABASE_URL=mysql+pymysql://building_code:password@mysql:3306/building_code?charset=utf8mb4
