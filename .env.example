# Docker Compose runtime variables. Copy to .env and replace the values.
APP_PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Production PostgreSQL (used with docker-compose.production.yml)
# POSTGRES_PASSWORD=replace-with-a-strong-password
# DATABASE_URL=postgresql+psycopg://building_code:...@postgres:5432/building_code
