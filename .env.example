# Docker Compose runtime variables. Copy to .env and replace the values.
APP_PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Production MySQL (used with docker-compose.production.yml)
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
# Persistent database URL. Keep the real value in Vercel/server environment variables.
# Local Docker production example:
# DATABASE_URL=mysql+pymysql://building_code:password@mysql:3306/building_code?charset=utf8mb4
DATABASE_URL=
# Set to 1 on Vercel or another serverless host to fail fast instead of using /tmp SQLite.
REQUIRE_PERSISTENT_DB=0
# Small pools are safer for serverless instances.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_RECYCLE=280
