{"article_id": 581, "specification": "GB50096-2011", "specification_name": "GB50096-2011住宅设计规范20211220（强条）", "clause_number": "5.3.5", "content": "单排布置设备的厨房净宽不应小于1.50m。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
