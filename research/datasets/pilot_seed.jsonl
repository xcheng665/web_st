{"article_id": 929, "specification": "GB55019-2021", "specification_name": "建筑与市政工程无障碍通用规范GB55019-2021", "clause_number": "3.4.7", "content": "窗户可开启扇的执手或启闭开关距地面高度应为0.85m～1.00m，手动开关窗户操作所需的力度不应大于25N。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
{"article_id": 932, "specification": "GB55019-2021", "specification_name": "建筑与市政工程无障碍通用规范GB55019-2021", "clause_number": "3.5.2", "content": "轮椅席位应设置在便于疏散的位置，并不应设置在公共通道范围内。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
{"article_id": 933, "specification": "GB55019-2021", "specification_name": "建筑与市政工程无障碍通用规范GB55019-2021", "clause_number": "3.5.3", "content": "轮椅席位区应通过无障碍通行设施与疏散出口、公共服务、卫生间、讲台等必要的功能空间和设施连接。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
