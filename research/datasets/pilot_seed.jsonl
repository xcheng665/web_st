{"article_id": 637, "specification": "GB50096-2011", "specification_name": "GB50096-2011住宅设计规范20211220（强条）", "clause_number": "7.1.7", "content": "采光窗下沿离楼面或地面高度低于0.50m的窗洞口面积不应计入采光面积内。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
