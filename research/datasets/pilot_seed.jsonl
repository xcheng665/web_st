{"article_id": 911, "specification": "GB55019-2021", "specification_name": "建筑与市政工程无障碍通用规范GB55019-2021", "clause_number": "3.2.2 3", "content": "无障碍厕位应符合下列规定：应设置无障碍坐便器。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
{"article_id": 924, "specification": "GB55019-2021", "specification_name": "建筑与市政工程无障碍通用规范GB55019-2021", "clause_number": "3.4.4 1", "content": "无障碍客房和无障碍住房、居室内应设置无障碍卫生间，并符合下列规定：应保证轮椅进出，内部应设轮椅回转空间；", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
