{"article_id": 584, "specification": "GB50096-2011", "specification_name": "GB50096-2011住宅设计规范20211220（强条）", "clause_number": "5.4.3", "content": "无前室的卫生间的门不应直接开向起居室（厅）或厨房。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
{"article_id": 586, "specification": "GB50096-2011", "specification_name": "GB50096-2011住宅设计规范20211220（强条）", "clause_number": "5.4.5", "content": "当卫生间布置在本套内的卧室、起居室（厅）、厨房和餐厅的上层时，均应有防水和便于检修的措施。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
{"article_id": 588, "specification": "GB50096-2011", "specification_name": "GB50096-2011住宅设计规范20211220（强条）", "clause_number": "5.5.1", "content": "住宅层高宜为2.80m。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
