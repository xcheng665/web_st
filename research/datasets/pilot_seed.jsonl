{"article_id": 573, "specification": "GB50096-2011", "specification_name": "GB50096-2011住宅设计规范20211220（强条）", "clause_number": "5.2.1", "content": "双人卧室的使用面积不应小于9m2。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
