{"article_id": 634, "specification": "GB50096-2011", "specification_name": "GB50096-2011住宅设计规范20211220（强条）", "clause_number": "7.1.3", "content": "卧室、起居室（厅）、厨房应有直接天然采光。", "split": "pilot", "annotation_status": "unannotated", "annotations": {"annotator_a": {"entities": [], "relations": [], "rules": []}, "annotator_b": {"entities": [], "relations": [], "rules": []}, "adjudicated": {"entities": [], "relations": [], "rules": []}}}
